---
# Scope kept deliberately narrow: bugprone-*/cert-* have a good
# signal-to-noise ratio for this codebase. The broader cppcoreguidelines-*/
# performance-*/portability-* sets were also tried (see wrenium-geo's
# identical .clang-tidy, which shares this library's conventions) and
# mostly conflict with this library's deliberate constraints -- zero-heap,
# no exceptions/RTTI, no GSL dependency, and an already-made #pragma once
# decision -- rather than finding real issues.
Checks: >
  -*,
  bugprone-*,
  cert-*
WarningsAsErrors: '*'
HeaderFilterRegex: 'include/wrenium/f32math/.*'
