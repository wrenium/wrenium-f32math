# Doxygen config for wrenium-f32math's API reference. Everything not listed
# here uses Doxygen's own default -- run `doxygen -g -` to see the full set.
# Generate with: doxygen Doxyfile (output: docs/api/html/index.html)

PROJECT_NAME           = "wrenium-f32math"
PROJECT_NUMBER         = 0.3.0
PROJECT_BRIEF          = "Header-only, float-only math approximations for single-precision-FPU embedded targets"
OUTPUT_DIRECTORY       = docs/api

INPUT                  = include/wrenium/f32math README.md
EXCLUDE_SYMBOLS         = wrenium::f32math::detail*
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
WARN_NO_PARAMDOC       = YES
SOURCE_BROWSER         = YES

GENERATE_LATEX         = NO
HAVE_DOT               = NO
